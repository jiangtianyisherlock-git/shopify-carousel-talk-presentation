{
  "name": "presentation",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:github": "tsc -b && vite build --base ./ --outDir dist-github",
    "build:v2": "tsc -b && VITE_DEMO_PLACEHOLDERS=1 vite build --base ./ --outDir dist-v2 && node scripts/remove-v2-demo-media.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "extract-narrations": "tsx scripts/extract-narrations.ts"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.5",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
